NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (development uses DATABASE_LOCAL)
DATABASE_LOCAL=mongodb://127.0.0.1:27017/restaurant-bo
DATABASE=mongodb+srv://user:<PASSWORD>@cluster.mongodb.net/restaurant-bo
DATABASE_PASSWORD=
DATABASE_SECOND=mongodb+srv://user:<PASSWORD>@cluster.mongodb.net/restaurant-bo
DATABASE_PASSWORD_SECOND=

# Auth — use a long random secret in production
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRE_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# URLs
CUSTOMER_APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000
CORS_ORIGINS=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Kispay (required for subscriptions in production)
KISPAY_API_KEY=
KISPAY_CLIENT_ID=
KISPAY_API_BASE_URL=https://api.kispay.et
KISPAY_WEBHOOK_SECRET=
KISPAY_WEBHOOK_URL=

# Business layer (additive — optional enforcement)
CAPABILITY_ENFORCEMENT=false
BRANCH_ACCESS_ENFORCEMENT=false

# System integrity audit (read-only; SUPER-ADMIN GET /api/v1/system/integrity/report)
INTEGRITY_CRON_ENABLED=false
INTEGRITY_CRON_INTERVAL_MS=86400000
INTEGRITY_SAMPLE_LIMIT=500
INTEGRITY_MAX_ISSUES_PER_AUDITOR=50

# Transactional outbox worker (Socket.IO delivery)
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=8
OUTBOX_LOCK_TIMEOUT_MS=60000

# Order idempotency (POST /order + Idempotency-Key header)
ORDER_IDEMPOTENCY_PROCESSING_TTL_MINUTES=5
ORDER_IDEMPOTENCY_RETENTION_HOURS=24
ORDER_IDEMPOTENCY_WAIT_TIMEOUT_SEC=30

# Optional
SESSION_DURATION_HOURS=4
TRUST_PROXY=false
REDIS_URL=

# Seeder only
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
