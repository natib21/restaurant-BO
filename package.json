{
  "name": "restaurant-bo",
  "version": "1.0.0",
  "description": "Restaurant Mgmt System that Automate the old System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "tsc",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand --forceExit --testPathIgnorePatterns=inventory.test.js --testPathIgnorePatterns=orders-integration.test.js --testPathIgnorePatterns=order-history.test.js",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:pre-commit": "npm run lint && npm run test:unit",
    "githooks:install": "git config core.hooksPath .githooks"
  },
  "author": "Nathnael Zelalem",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.10",
    "puppeteer": "^21.3.8",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1",
    "validator": "^13.12.0",
    "winston": "^3.15.0",
    "xss": "^1.0.15",
    "xss-filters": "^1.2.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.6.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
